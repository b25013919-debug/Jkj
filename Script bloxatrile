local AuraInstance = nil

local function UpdateHands()
    local char = LocalPlayer.Character
    if not char then return end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            local name = part.Name:lower()
            if name:find("arm") or name:find("hand") or name == "left arm" or name == "right arm" then
                if Settings.HandsTransparent then
                    part.Transparency = 0.55
                else
                    part.Transparency = 0
                end
                if Settings.HandsColorful then
                    part.Color = Color3.fromHSV((tick() % 4) / 4, 0.85, 1)
                end
            end
        end
    end
end

local function UpdateAura()
    if AuraInstance then
        pcall(function() AuraInstance:Destroy() end)
        AuraInstance = nil
    end
    if not Settings.Aura then return end

    local char = LocalPlayer.Character
    if not char then return end

    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(0, 255, 140)
    hl.OutlineColor = Color3.fromRGB(0, 200, 120)
    hl.FillTransparency = 0.72
    hl.OutlineTransparency = 0.25
    hl.Parent = char
    AuraInstance = hl
end


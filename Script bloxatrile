local function ScanRemotes()
    print("[Grok] ===== Начинаю поиск RemoteEvents/Functions =====")

    local keywords = {
        shoot = "Shoot",
        fire = "Shoot",
        bullet = "Shoot",
        gun = "Shoot",
        shot = "Shoot",
        damage = "Damage",
        hit = "Hit",
        hurt = "Damage",
        attack = "Shoot",
        weapon = "Shoot",
        projectile = "Shoot",
        ray = "Shoot",
        impact = "Hit",
        kill = "Damage",
    }

    local function checkName(name)
        local lower = string.lower(name)
        for key, category in pairs(keywords) do
            if string.find(lower, key) then
                return category
            end
        end
        return "Other"
    end

    local function scan(obj)
        for _, child in ipairs(obj:GetDescendants()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                local category = checkName(child.Name)
                table.insert(FoundRemotes[category], {
                    Remote = child,
                    Name = child.Name,
                    Class = child.ClassName,
                    Path = child:GetFullName()
                })
                print(string.format("[Grok] [%s] %s (%s)", category, child:GetFullName(), child.ClassName))
            end
        end
    end

    pcall(function() scan(ReplicatedStorage) end)
    pcall(function() scan(Workspace) end)
    pcall(function()
        if LocalPlayer.Character then
            scan(LocalPlayer.Character)
        end
    end)
    pcall(function()
        if LocalPlayer:FindFirstChild("Backpack") then
            scan(LocalPlayer.Backpack)
        end
    end)

    AddConnection(LocalPlayer.CharacterAdded:Connect(function(char)
        task.wait(1.5)
        pcall(function()
            for _, child in ipairs(char:GetDescendants()) do
                if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                    local category = checkName(child.Name)
                    table.insert(FoundRemotes[category], {
                        Remote = child,
                        Name = child.Name,
                        Class = child.ClassName,
                        Path = child:GetFullName()
                    })
                    print(string.format("[Grok] [NEW] [%s] %s", category, child:GetFullName()))
                end
            end
        end)
    end))

    local total = #FoundRemotes.Shoot + #FoundRemotes.Damage + #FoundRemotes.Hit + #FoundRemotes.Other
    print("[Grok] ===== Найдено ремоутов: " .. total .. " =====")
    print("[Grok] Shoot: " .. #FoundRemotes.Shoot .. " | Damage: " .. #FoundRemotes.Damage .. " | Hit: " .. #FoundRemotes.Hit .. " | Other: " .. #FoundRemotes.Other)

    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Grok BloxStrike",
            Text = "Найдено ремоутов: " .. total .. "\nShoot: " .. #FoundRemotes.Shoot,
            Duration = 5
        })
    end)
end


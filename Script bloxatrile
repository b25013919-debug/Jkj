            info.Text = "BloxStrike — 5v5 тактический шутер\nв стиле CS.\n\nРемоуты найдены автоматически.\nСмотри консоль (F9 / Log)."
            info.TextColor3 = Color3.fromRGB(180, 180, 190)
            info.TextSize = 13
            info.Font = Enum.Font.Gotham
            info.TextWrapped = true
            info.Parent = ContentFrame

            local infoCorner = Instance.new("UICorner")
            infoCorner.CornerRadius = UDim.new(0, 10)
            infoCorner.Parent = info

            CreateSection("REMOTES")
            local remoteInfo = Instance.new("TextLabel")
            remoteInfo.Size = UDim2.new(1, 0, 0, 70)
            remoteInfo.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
            remoteInfo.Text = "Shoot: " .. #FoundRemotes.Shoot .. "\nDamage: " .. #FoundRemotes.Damage .. "\nHit: " .. #FoundRemotes.Hit .. "\nOther: " .. #FoundRemotes.Other
            remoteInfo.TextColor3 = Color3.fromRGB(0, 255, 140)
            remoteInfo.TextSize = 13
            remoteInfo.Font = Enum.Font.GothamBold
            remoteInfo.Parent = ContentFrame

            local rCorner = Instance.new("UICorner")
            rCorner.CornerRadius = UDim.new(0, 10)
            rCorner.Parent = remoteInfo

            CreateSection("ACTIONS")
            local rescanBtn = Instance.new("TextButton")
            rescanBtn.Size = UDim2.new(1, 0, 0, 48)
            rescanBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
            rescanBtn.Text = "Пересканировать ремоуты"
            rescanBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            rescanBtn.TextSize = 14
            rescanBtn.Font = Enum.Font.GothamBold
            rescanBtn.Parent = ContentFrame

            local rbCorner = Instance.new("UICorner")
            rbCorner.CornerRadius = UDim.new(0, 10)
            rbCorner.Parent = rescanBtn

            rescanBtn.MouseButton1Click:Connect(function()
                FoundRemotes = {Shoot = {}, Damage = {}, Hit = {}, Other = {}}
                ScanRemotes()
                ShowTab("Misc")
            end)
        end
    end

    for i, name in ipairs(Tabs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1 / #Tabs, -4, 1, 0)
        btn.Position = UDim2.new((i - 1) / #Tabs, 2, 0, 0)
        btn.BackgroundColor3 = i == 1 and Color3.fromRGB(0, 255, 140) or Color3.fromRGB(28, 28, 38)
        btn.Text = name
        btn.TextColor3 = i == 1 and Color3.fromRGB(10, 10, 14) or Color3.fromRGB(170, 170, 180)
        btn.TextSize = 12
        btn.Font = Enum.Font.GothamBold
        btn.AutoButtonColor = false
        btn.Parent = TabBar

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 8)
        c.Parent = btn

        TabButtons[name] = btn

        btn.MouseButton1Click:Connect(function()
            ShowTab(name)
        end)
    end

    ToggleBtn.MouseButton1Click:Connect(function()
        MenuOpen = not MenuOpen
        MainFrame.Visible = MenuOpen
        CreateTween(ToggleBtn, {
            BackgroundColor3 = MenuOpen and Color3.fromRGB(0, 255, 140) or Color3.fromRGB(40, 40, 50)
        }, 0.2)
    end)

    -- Перетаскивание кнопки G
    local dragging = false
    local dragStart, startPos

    ToggleBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = ToggleBtn.Position
        end
    end)

    ToggleBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    AddConnection(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - dragStart
            ToggleBtn.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end))

    ShowTab("Combat")
end

